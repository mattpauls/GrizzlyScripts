# Same values as grizzly-db-remix/.env

# FileMaker server, e.g. https://fms.example.com — service account needs the
# fmrest extended privilege in each "edu class" file
FM_BASE_URL=
FM_SERVICE_USERNAME=
FM_SERVICE_PASSWORD=
FM_QUERY_LIMIT=500

# GrizzlyDB photo bucket (S3/MinIO)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET=
